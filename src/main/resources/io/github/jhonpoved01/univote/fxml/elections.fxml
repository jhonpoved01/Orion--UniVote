<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.jhonpoved01.univote.controller.ElectionsController"
            stylesheets="@../css/theme.css" styleClass="app-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="topbar">
            <padding><Insets top="18" right="32" bottom="18" left="32"/></padding>
            <VBox spacing="2">
                <Label text="Elecciones disponibles" styleClass="topbar-title"/>
                <Label text="Selecciona un proceso y conoce sus candidaturas"
                       styleClass="topbar-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="Volver al dashboard"
                    onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="electoral-content">
            <children>
                <HBox spacing="22" maxWidth="1180">
                    <VBox spacing="14" prefWidth="460" HBox.hgrow="ALWAYS"
                          styleClass="electoral-panel">
                        <Label text="1. Elige una elección" styleClass="section-title"/>
                        <Label text="Solo se muestran procesos activos dentro de su periodo de votación."
                               wrapText="true" styleClass="section-subtitle"/>
                        <ListView fx:id="electionList" VBox.vgrow="ALWAYS"
                                  styleClass="electoral-list"/>
                        <Label fx:id="emptyElectionsLabel"
                               text="No hay elecciones disponibles en este momento."
                               visible="false" managed="false" wrapText="true"
                               styleClass="empty-state"/>
                    </VBox>
                    <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="electoral-panel">
                        <Label text="2. Selecciona una candidatura" styleClass="section-title"/>
                        <Label fx:id="candidacyPromptLabel"
                               text="Selecciona primero una elección."
                               wrapText="true" styleClass="section-subtitle"/>
                        <ListView fx:id="candidacyList" VBox.vgrow="ALWAYS"
                                  styleClass="electoral-list, candidacy-list"/>
                        <Label fx:id="errorLabel" text="" visible="false" managed="false"
                               wrapText="true" styleClass="electoral-error"/>
                        <Button fx:id="confirmVoteButton" text="Confirmar voto"
                                maxWidth="Infinity" disable="true"
                                onAction="#handleConfirmVote"
                                styleClass="primary-button, confirm-vote-button"/>
                    </VBox>
                </HBox>
                <VBox alignment="CENTER" spacing="10" mouseTransparent="true">
                    <ProgressIndicator fx:id="progressIndicator" visible="false"
                                       managed="false" prefWidth="52" prefHeight="52"
                                       styleClass="electoral-progress"/>
                    <Label text="Procesando…" styleClass="loading-label"
                           visible="false" managed="false"/>
                </VBox>
            </children>
            <padding><Insets top="30" right="32" bottom="32" left="32"/></padding>
        </StackPane>
    </center>
</BorderPane>
